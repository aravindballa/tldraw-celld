# copy to .env and edit

# bundled SeaweedFS S3 store. remove this line to use an external bucket instead
COMPOSE_PROFILES=local-s3

# S3 credentials (for bundled SeaweedFS these are created on first start)
S3_ACCESS_KEY=tldraw
S3_SECRET_KEY=change-me-to-a-long-random-string
BUCKET=tldraw

# external bucket example (Cloudflare R2). must support conditional writes:
# AWS S3, R2, Tigris, GCS qualify; B2 / Hetzner / DO Spaces do not
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_REGION=auto

# host port for the app (plain HTTP; put your own TLS proxy in front for a domain)
PORT=8080
